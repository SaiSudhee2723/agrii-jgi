# ============================================================================
# GEOSENSE BACKEND ENVIRONMENT CONFIGURATION (TEMPLATE)
# ============================================================================

PROJECT_NAME="Geosense Smart Agriculture API"
API_V1_STR="/api/v1"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000,http://127.0.0.1:5500"

# Supabase Credentials (from your Supabase project settings -> API)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_JWT_SECRET="your-jwt-secret"

# Weather API (Optional OpenWeatherMap key; falls back to free Open-Meteo if empty)
OPENWEATHER_API_KEY=""

# Market Price Mode: 'demo' or 'live'
MARKET_DATA_MODE="demo"
